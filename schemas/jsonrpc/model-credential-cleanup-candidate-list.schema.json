{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_ModelCredentialCleanupCandidate",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ModelCredentialCleanupCandidate"
  },
  "$defs": {
    "ModelConnectionReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    "ModelCredentialCleanupCandidate": {
      "type": "object",
      "properties": {
        "activeLeaseIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authGeneration": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "blockedReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelConnectionReference"
          }
        },
        "canPrepare": {
          "type": "boolean"
        },
        "cleanupId": {
          "type": "string"
        },
        "connectionId": {
          "type": "string"
        },
        "credentialRef": {
          "$ref": "#/$defs/ModelSecretRef"
        },
        "deletedConnection": {
          "type": "boolean"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCredentialCleanupPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "type": "string"
        },
        "referenceDigest": {
          "type": "string"
        },
        "sourceOperationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/ModelCredentialCleanupState"
        }
      },
      "additionalProperties": false,
      "required": [
        "cleanupId",
        "profileId",
        "connectionId",
        "authGeneration",
        "credentialRef",
        "sourceOperationIds",
        "deletedConnection",
        "blockedReferences",
        "activeLeaseIds",
        "canPrepare",
        "referenceDigest",
        "state"
      ]
    },
    "ModelCredentialCleanupPlan": {
      "type": "object",
      "properties": {
        "authGeneration": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cleanupId": {
          "type": "string"
        },
        "confirmedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "connectionId": {
          "type": "string"
        },
        "credentialRef": {
          "$ref": "#/$defs/ModelSecretRef"
        },
        "preparedAt": {
          "type": "integer",
          "format": "int64"
        },
        "profileId": {
          "type": "string"
        },
        "referenceDigest": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ModelCredentialCleanupPlanState"
        }
      },
      "additionalProperties": false,
      "required": [
        "cleanupId",
        "profileId",
        "connectionId",
        "authGeneration",
        "credentialRef",
        "referenceDigest",
        "state",
        "preparedAt"
      ]
    },
    "ModelCredentialCleanupPlanState": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed"
      ]
    },
    "ModelCredentialCleanupState": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "confirmed",
        "unconfirmed"
      ]
    },
    "ModelSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
