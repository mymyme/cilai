{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalSearchResult",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlobalSearchItem"
      }
    },
    "total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "items",
    "total"
  ],
  "$defs": {
    "GlobalSearchItem": {
      "type": "object",
      "properties": {
        "deliverableId": {
          "type": [
            "string",
            "null"
          ]
        },
        "localFileId": {
          "type": [
            "string",
            "null"
          ]
        },
        "objectId": {
          "type": "string"
        },
        "objectType": {
          "type": "string"
        },
        "phaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "relativePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "integer",
          "format": "int64"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "objectType",
        "objectId",
        "title",
        "subtitle",
        "workspaceId",
        "updatedAt"
      ]
    }
  }
}
