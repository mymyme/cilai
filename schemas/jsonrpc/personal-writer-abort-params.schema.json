{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalWriterAbortParams",
  "type": "object",
  "properties": {
    "leaseId": {
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/ModelExecutionOwner"
    }
  },
  "additionalProperties": false,
  "required": [
    "leaseId",
    "owner"
  ],
  "$defs": {
    "ModelExecutionOwner": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startFingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instanceId",
        "pid",
        "startFingerprint"
      ]
    }
  }
}
