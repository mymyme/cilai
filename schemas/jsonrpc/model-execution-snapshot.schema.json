{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelExecutionSnapshot",
  "type": "object",
  "properties": {
    "authGeneration": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "authMode": {
      "$ref": "#/$defs/ModelAuthMode"
    },
    "baseUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "bindingId": {
      "type": [
        "string",
        "null"
      ]
    },
    "bindingRevision": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ModelCapabilityEvidence"
      }
    },
    "configRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "connectionId": {
      "type": "string"
    },
    "contextWindowTokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "defaultReasoningEffort": {
      "type": [
        "string",
        "null"
      ]
    },
    "descriptorRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "inputModalities": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "instanceFence": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ModelConnectionKind"
    },
    "localRuntime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalModelRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelId": {
      "type": "string"
    },
    "network": {
      "$ref": "#/$defs/ModelNetworkConfig"
    },
    "profileId": {
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/ModelPurpose"
    },
    "reasoningEffort": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtimeHomeScope": {
      "type": "string"
    },
    "runtimeKind": {
      "$ref": "#/$defs/ModelRuntimeKind"
    },
    "secretRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelSecretRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "supportedReasoningEfforts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "validationId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "runtimeKind",
    "profileId",
    "instanceFence",
    "connectionId",
    "kind",
    "configRevision",
    "authGeneration",
    "purpose",
    "modelId",
    "authMode",
    "network",
    "runtimeHomeScope",
    "descriptorRevision",
    "capabilities"
  ],
  "$defs": {
    "LocalModelRuntime": {
      "type": "string",
      "enum": [
        "ollama",
        "lmstudio"
      ]
    },
    "ModelAuthMode": {
      "type": "string",
      "enum": [
        "none",
        "api_key",
        "runtime_managed_chatgpt"
      ]
    },
    "ModelCapabilityEvidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ModelEvidenceSource"
        },
        "state": {
          "$ref": "#/$defs/ModelCapabilityState"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "source"
      ]
    },
    "ModelCapabilityState": {
      "type": "string",
      "enum": [
        "unverified",
        "supported",
        "unsupported"
      ]
    },
    "ModelConnectionKind": {
      "type": "string",
      "enum": [
        "openai_key",
        "chatgpt",
        "custom_responses",
        "local"
      ]
    },
    "ModelEvidenceSource": {
      "type": "string",
      "enum": [
        "user_declared",
        "service_declared",
        "runtime_catalog",
        "observed"
      ]
    },
    "ModelNetworkAuthentication": {
      "type": "string",
      "enum": [
        "none",
        "basic"
      ]
    },
    "ModelNetworkConfig": {
      "type": "object",
      "properties": {
        "caCertificatePem": {
          "type": [
            "string",
            "null"
          ]
        },
        "headerNames": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/ModelNetworkMode",
          "default": "direct"
        },
        "proxyAuth": {
          "$ref": "#/$defs/ModelNetworkAuthentication",
          "default": "none"
        },
        "proxySecretRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxyUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceAuth": {
          "$ref": "#/$defs/ModelNetworkAuthentication",
          "default": "none"
        }
      },
      "additionalProperties": false
    },
    "ModelNetworkMode": {
      "type": "string",
      "enum": [
        "direct",
        "system_proxy",
        "custom_proxy"
      ]
    },
    "ModelPurpose": {
      "type": "string",
      "enum": [
        "foreground",
        "automation",
        "review",
        "memory",
        "page_ai"
      ]
    },
    "ModelRuntimeKind": {
      "type": "string",
      "enum": [
        "workbench",
        "application"
      ]
    },
    "ModelSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
