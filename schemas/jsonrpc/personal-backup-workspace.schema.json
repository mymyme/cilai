{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalBackupWorkspace",
  "type": "object",
  "properties": {
    "archivePrefix": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentSnapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersonalWorkspaceContentSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "displayName": {
      "type": "string"
    },
    "originalFilesIncluded": {
      "type": "boolean"
    },
    "originalPath": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "displayName",
    "originalPath",
    "originalFilesIncluded"
  ],
  "$defs": {
    "PersonalWorkspaceContentEntry": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "fileIdentity": {
          "type": "string"
        },
        "fileType": {
          "type": "string"
        },
        "localFileId": {
          "type": "string"
        },
        "modifiedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "relativePath": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateRevision": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "localFileId",
        "relativePath",
        "fileType",
        "fileIdentity",
        "stateRevision"
      ]
    },
    "PersonalWorkspaceContentSnapshot": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonalWorkspaceContentEntry"
          }
        },
        "fullGeneration": {
          "type": "integer",
          "format": "int64"
        },
        "fullSnapshotId": {
          "type": "string"
        },
        "latestGeneration": {
          "type": "integer",
          "format": "int64"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rootIdentity": {
          "type": "string"
        },
        "rootPath": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "workspaceRevision": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "workspaceId",
        "rootIdentity",
        "rootPath",
        "workspaceRevision",
        "latestGeneration",
        "fullSnapshotId",
        "fullGeneration",
        "digest",
        "entries"
      ]
    }
  }
}
