{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalStorageInventory",
  "type": "object",
  "properties": {
    "activeWriterCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersonalStorageCoverage"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersonalStorageItem"
      }
    },
    "knownLogicalBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "profileId": {
      "type": "string"
    },
    "profilePath": {
      "type": "string"
    },
    "scannedAt": {
      "type": "integer",
      "format": "int64"
    },
    "sizeComplete": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "profileId",
    "profilePath",
    "scannedAt",
    "knownLogicalBytes",
    "sizeComplete",
    "activeWriterCount",
    "coverage",
    "items",
    "issues"
  ],
  "$defs": {
    "PersonalStorageCategory": {
      "type": "string",
      "enum": [
        "cache",
        "logs",
        "attachments",
        "application_data",
        "skills",
        "applications",
        "native_history",
        "native_memory",
        "recovery_copies",
        "business_database",
        "configuration",
        "project_originals",
        "other_protected"
      ]
    },
    "PersonalStorageCoverage": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/PersonalStorageCategory"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PersonalStorageCoverageState"
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "scope",
        "state"
      ]
    },
    "PersonalStorageCoverageState": {
      "type": "string",
      "enum": [
        "covered",
        "not_scanned",
        "unavailable",
        "external_reference"
      ]
    },
    "PersonalStorageItem": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/PersonalStorageCategory"
        },
        "cleanupAllowed": {
          "type": "boolean"
        },
        "displayPath": {
          "type": "string"
        },
        "fileCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "itemId": {
          "type": "string"
        },
        "logicalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "managedRelativePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonalStorageReference"
          }
        },
        "snapshotDigest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "itemId",
        "category",
        "displayPath",
        "cleanupAllowed",
        "reasons",
        "references"
      ]
    },
    "PersonalStorageReference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "objectId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "objectId"
      ]
    }
  }
}
