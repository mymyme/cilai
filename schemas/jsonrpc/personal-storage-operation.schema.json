{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalStorageOperation",
  "type": "object",
  "properties": {
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "integer",
      "format": "int64"
    },
    "operationId": {
      "type": "string"
    },
    "previewDigest": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "requiresQuiescence": {
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersonalStorageResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PersonalStorageItem"
      }
    },
    "selectedLogicalBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "state": {
      "$ref": "#/$defs/PersonalStorageOperationState"
    },
    "updatedAt": {
      "type": "integer",
      "format": "int64"
    }
  },
  "additionalProperties": false,
  "required": [
    "operationId",
    "profileId",
    "state",
    "previewDigest",
    "createdAt",
    "updatedAt",
    "selectedItems",
    "selectedLogicalBytes",
    "requiresQuiescence",
    "blockers"
  ],
  "$defs": {
    "PersonalStorageCategory": {
      "type": "string",
      "enum": [
        "cache",
        "logs",
        "attachments",
        "application_data",
        "skills",
        "applications",
        "native_history",
        "native_memory",
        "recovery_copies",
        "business_database",
        "configuration",
        "project_originals",
        "other_protected"
      ]
    },
    "PersonalStorageItem": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/PersonalStorageCategory"
        },
        "cleanupAllowed": {
          "type": "boolean"
        },
        "displayPath": {
          "type": "string"
        },
        "fileCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "itemId": {
          "type": "string"
        },
        "logicalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "managedRelativePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonalStorageReference"
          }
        },
        "snapshotDigest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "itemId",
        "category",
        "displayPath",
        "cleanupAllowed",
        "reasons",
        "references"
      ]
    },
    "PersonalStorageItemResult": {
      "type": "object",
      "properties": {
        "deletedFileCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "deletedLogicalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "itemId": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PersonalStorageOutcome"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retainedRelativePath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "itemId",
        "outcome"
      ]
    },
    "PersonalStorageOperationState": {
      "type": "string",
      "enum": [
        "prepared",
        "applying",
        "completed",
        "incomplete",
        "cancelled"
      ]
    },
    "PersonalStorageOutcome": {
      "type": "string",
      "enum": [
        "deleted",
        "retained",
        "unconfirmed"
      ]
    },
    "PersonalStorageReference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "objectId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "objectId"
      ]
    },
    "PersonalStorageResult": {
      "type": "object",
      "properties": {
        "deletedFileCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "deletedLogicalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonalStorageItemResult"
          }
        },
        "physicalSpaceReleased": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "issues"
      ]
    }
  }
}
