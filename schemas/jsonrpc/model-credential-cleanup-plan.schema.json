{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCredentialCleanupPlan",
  "type": "object",
  "properties": {
    "authGeneration": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "cleanupId": {
      "type": "string"
    },
    "confirmedAt": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "connectionId": {
      "type": "string"
    },
    "credentialRef": {
      "$ref": "#/$defs/ModelSecretRef"
    },
    "preparedAt": {
      "type": "integer",
      "format": "int64"
    },
    "profileId": {
      "type": "string"
    },
    "referenceDigest": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ModelCredentialCleanupPlanState"
    }
  },
  "additionalProperties": false,
  "required": [
    "cleanupId",
    "profileId",
    "connectionId",
    "authGeneration",
    "credentialRef",
    "referenceDigest",
    "state",
    "preparedAt"
  ],
  "$defs": {
    "ModelCredentialCleanupPlanState": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed"
      ]
    },
    "ModelSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
