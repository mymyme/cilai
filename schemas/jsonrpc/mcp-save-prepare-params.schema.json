{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpSavePrepareParams",
  "type": "object",
  "properties": {
    "config": {
      "$ref": "#/$defs/McpConnectionConfig"
    },
    "connectionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "credentialAction": {
      "$ref": "#/$defs/McpCredentialAction"
    },
    "expectedRevision": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "operationId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "operationId",
    "config",
    "credentialAction"
  ],
  "$defs": {
    "McpAuthMode": {
      "type": "string",
      "enum": [
        "none",
        "bearer",
        "environment"
      ]
    },
    "McpConnectionConfig": {
      "type": "object",
      "properties": {
        "authMode": {
          "$ref": "#/$defs/McpAuthMode"
        },
        "environmentVariables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/McpNetworkConfig"
        },
        "source": {
          "$ref": "#/$defs/McpSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "authMode",
        "environmentVariables",
        "network"
      ]
    },
    "McpCredentialAction": {
      "type": "string",
      "enum": [
        "keep",
        "replace",
        "clear"
      ]
    },
    "McpLocalPermissions": {
      "type": "object",
      "properties": {
        "childProcesses": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "readRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writeRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "readRoots",
        "writeRoots",
        "network",
        "childProcesses"
      ]
    },
    "McpNetworkConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ModelNetworkMode"
        },
        "proxyUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "McpSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "local_command"
            },
            "permissions": {
              "$ref": "#/$defs/McpLocalPermissions"
            },
            "program": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "program",
            "args",
            "cwd",
            "permissions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "remote_http"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "ModelNetworkMode": {
      "type": "string",
      "enum": [
        "direct",
        "system_proxy",
        "custom_proxy"
      ]
    }
  }
}
