      "required": [
        "projectId",
        "displayName",
        "goal",
        "status",
        "workspaceIds",
        "stateRevision",
        "updatedAt",
        "hasPlan",
        "activePhases",
        "taskTotal",
        "taskCompleted",
        "deliverableTotal",
        "deliverableAccepted",
        "blockerCount",
