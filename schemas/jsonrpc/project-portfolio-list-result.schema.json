        "decisionCount": {
          "type": "integer",
          "format": "int64"
        },
        "deliverableAccepted": {
          "type": "integer",
          "format": "int64"
        },
        "deliverableTotal": {
          "type": "integer",
          "format": "int64"
        },
        "displayName": {
          "type": "string"
