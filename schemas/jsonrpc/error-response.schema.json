{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorResponse",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorObject"
    },
    "id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestId"
        },
        {
          "type": "null"
        }
      ]
    },
    "jsonrpc": {
      "type": "string"
    }
  },
  "required": [
    "jsonrpc",
    "error"
  ],
  "$defs": {
    "ErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "int32"
        }
      ]
    }
  }
}
