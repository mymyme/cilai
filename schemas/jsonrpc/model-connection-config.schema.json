{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelConnectionConfig",
  "type": "object",
  "properties": {
    "authMode": {
      "$ref": "#/$defs/ModelAuthMode"
    },
    "baseUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/$defs/ModelConnectionKind"
    },
    "localRuntime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalModelRuntime"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "network": {
      "$ref": "#/$defs/ModelNetworkConfig",
      "default": {
        "headerNames": [],
        "mode": "direct",
        "proxyAuth": "none",
        "proxySecretRef": null,
        "proxyUrl": null,
        "serviceAuth": "none"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "kind",
    "authMode",
    "enabled"
  ],
  "$defs": {
    "LocalModelRuntime": {
      "type": "string",
      "enum": [
        "ollama",
        "lmstudio"
      ]
    },
    "ModelAuthMode": {
      "type": "string",
      "enum": [
        "none",
        "api_key",
        "runtime_managed_chatgpt"
      ]
    },
    "ModelConnectionKind": {
      "type": "string",
      "enum": [
        "openai_key",
        "chatgpt",
        "custom_responses",
        "local"
      ]
    },
    "ModelNetworkAuthentication": {
      "type": "string",
      "enum": [
        "none",
        "basic"
      ]
    },
    "ModelNetworkConfig": {
      "type": "object",
      "properties": {
        "caCertificatePem": {
          "type": [
            "string",
            "null"
          ]
        },
        "headerNames": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/ModelNetworkMode",
          "default": "direct"
        },
        "proxyAuth": {
          "$ref": "#/$defs/ModelNetworkAuthentication",
          "default": "none"
        },
        "proxySecretRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxyUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceAuth": {
          "$ref": "#/$defs/ModelNetworkAuthentication",
          "default": "none"
        }
      },
      "additionalProperties": false
    },
    "ModelNetworkMode": {
      "type": "string",
      "enum": [
        "direct",
        "system_proxy",
        "custom_proxy"
      ]
    },
    "ModelSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
