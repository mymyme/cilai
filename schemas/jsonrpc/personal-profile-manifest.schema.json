{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalProfileManifest",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
