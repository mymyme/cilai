{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpLocalPermissions",
  "type": "object",
  "properties": {
    "childProcesses": {
      "type": "boolean"
    },
    "network": {
      "type": "boolean"
    },
    "readRoots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writeRoots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "readRoots",
    "writeRoots",
    "network",
    "childProcesses"
  ]
}
