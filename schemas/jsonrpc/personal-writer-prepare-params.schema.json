{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalWriterPrepareParams",
  "type": "object",
  "properties": {
    "clientOperationId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "launchProtocol": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "owner": {
      "$ref": "#/$defs/ModelExecutionOwner"
    },
    "processMode": {
      "$ref": "#/$defs/PersonalWriterMode"
    },
    "resourceId": {
      "type": "string"
    },
    "resourceRevision": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "clientOperationId",
    "kind",
    "resourceId",
    "resourceRevision",
    "owner",
    "launchProtocol",
    "processMode"
  ],
  "$defs": {
    "ModelExecutionOwner": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startFingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instanceId",
        "pid",
        "startFingerprint"
      ]
    },
    "PersonalWriterMode": {
      "type": "string",
      "enum": [
        "local_process",
        "remote_request"
      ]
    }
  }
}
