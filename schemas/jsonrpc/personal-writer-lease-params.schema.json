{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalWriterLeaseParams",
  "type": "object",
  "properties": {
    "leaseId": {
      "type": "string"
    },
    "localTransportFinished": {
      "type": "boolean",
      "default": false
    },
    "owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelExecutionOwner"
        },
        {
          "type": "null"
        }
      ]
    },
    "remoteOutcomeUnconfirmed": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false,
  "required": [
    "leaseId"
  ],
  "$defs": {
    "ModelExecutionOwner": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startFingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instanceId",
        "pid",
        "startFingerprint"
      ]
    }
  }
}
