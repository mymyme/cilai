{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCredentialCleanupConfirmParams",
  "type": "object",
  "properties": {
    "cleanupId": {
      "type": "string"
    },
    "credentialRef": {
      "$ref": "#/$defs/ModelSecretRef"
    },
    "expectedReferenceDigest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "cleanupId",
    "expectedReferenceDigest",
    "credentialRef"
  ],
  "$defs": {
    "ModelSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
