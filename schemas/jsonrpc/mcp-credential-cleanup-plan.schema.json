{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpCredentialCleanupPlan",
  "type": "object",
  "properties": {
    "cleanupId": {
      "type": "string"
    },
    "credentialRef": {
      "$ref": "#/$defs/McpSecretRef"
    },
    "profileId": {
      "type": "string"
    },
    "referenceDigest": {
      "type": "string"
    },
    "sourceOperationIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "$ref": "#/$defs/McpCredentialCleanupState"
    }
  },
  "additionalProperties": false,
  "required": [
    "cleanupId",
    "profileId",
    "credentialRef",
    "state",
    "sourceOperationIds",
    "referenceDigest"
  ],
  "$defs": {
    "McpCredentialCleanupState": {
      "type": "string",
      "enum": [
        "prepared",
        "confirmed"
      ]
    },
    "McpSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
