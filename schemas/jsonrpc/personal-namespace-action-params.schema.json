{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalNamespaceActionParams",
  "type": "object",
  "properties": {
    "actionId": {
      "type": "string"
    },
    "executionProcesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelExecutionProcess"
      }
    },
    "operationId": {
      "type": "string"
    },
    "permitToken": {
      "type": "string"
    },
    "shellOwner": {
      "$ref": "#/$defs/ModelExecutionOwner"
    }
  },
  "additionalProperties": false,
  "required": [
    "operationId",
    "actionId",
    "permitToken",
    "shellOwner",
    "executionProcesses"
  ],
  "$defs": {
    "ModelExecutionOwner": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startFingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "instanceId",
        "pid",
        "startFingerprint"
      ]
    },
    "ModelExecutionProcess": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startFingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "pid",
        "startFingerprint"
      ]
    }
  }
}
