{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelUsageFinishParams",
  "type": "object",
  "properties": {
    "cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelUsageCost"
        },
        {
          "type": "null"
        }
      ]
    },
    "leaseId": {
      "type": "string"
    },
    "reasonCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "responseIdSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshotDigest": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ModelUsageState"
    },
    "tokens": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelUsageTokens"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "requestId",
    "leaseId",
    "snapshotDigest",
    "state"
  ],
  "$defs": {
    "ModelUsageCost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "source"
      ]
    },
    "ModelUsageState": {
      "type": "string",
      "enum": [
        "started",
        "completed",
        "failed",
        "unconfirmed"
      ]
    },
    "ModelUsageTokens": {
      "type": "object",
      "properties": {
        "cacheWriteInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "totalTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
