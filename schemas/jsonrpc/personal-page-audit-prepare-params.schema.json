{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalPageAuditPrepareParams",
  "type": "object",
  "properties": {
    "argumentsDigest": {
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/PersonalPageBindingParams"
    },
    "documentId": {
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/PersonalPageAuditMethod"
    },
    "operationId": {
      "type": "string"
    },
    "permissionDigest": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
