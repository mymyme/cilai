        "ui_action_invoke",
        "model_session_create",
        "model_session_read",
        "model_message_read",
        "model_run_create",
        "model_run_read",
        "model_run_cancel",
        "model_write_resolve",
        "conversation_handoff_prepare",
        "conversation_handoff_commit",
        "tool_read",
        "tool_write"
      ]
