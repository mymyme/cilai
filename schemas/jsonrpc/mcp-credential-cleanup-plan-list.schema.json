{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_McpCredentialCleanupPlan",
  "type": "array",
  "items": {
    "$ref": "#/$defs/McpCredentialCleanupPlan"
  },
  "$defs": {
    "McpCredentialCleanupPlan": {
      "type": "object",
      "properties": {
        "cleanupId": {
          "type": "string"
        },
        "credentialRef": {
          "$ref": "#/$defs/McpSecretRef"
        },
        "profileId": {
          "type": "string"
        },
        "referenceDigest": {
          "type": "string"
        },
        "sourceOperationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/McpCredentialCleanupState"
        }
      },
      "additionalProperties": false,
      "required": [
        "cleanupId",
        "profileId",
        "credentialRef",
        "state",
        "sourceOperationIds",
        "referenceDigest"
      ]
    },
    "McpCredentialCleanupState": {
      "type": "string",
      "enum": [
        "prepared",
        "confirmed"
      ]
    },
    "McpSecretRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "service": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "service",
        "account"
      ]
    }
  }
}
